// Prisma schema untuk pakeai (AI Planner versi refactor).
// Tabel Better Auth + domain aplikasi. Fresh migrate — data lama di-drop.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Better Auth — tabel wajib sesuai Prisma adapter
// ============================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  agentTokens   AgentToken[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String   @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  password              String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================
// Domain — port dari supabase/migrations/*, rename PRD -> Brd
// ============================================================

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  idea        String   // ide mentah dari onboarding
  description String?
  status      String   @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  reviewFlow  Boolean  @default(false)   // bila true, complete -> REVIEW dulu
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  stacks         Stack[]
  questions      DiscoveryQuestion[]
  brd            Brd?
  roadmap        RoadmapPhase[]
  tasks          Task[]
  agentTokens    AgentToken[]
  checkpoints    Checkpoint[]

  @@index([userId])
}

model Stack {
  id        String  @id @default(cuid())
  projectId String
  category  String  // frontend | backend | database | deployment
  name      String
  version   String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model DiscoveryQuestion {
  id        String  @id @default(cuid())
  projectId String
  order     Int
  question  String
  context   String?

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  answers DiscoveryAnswer[]

  @@index([projectId])
}

model DiscoveryAnswer {
  id         String   @id @default(cuid())
  questionId String
  answer     String
  createdAt  DateTime @default(now())

  question DiscoveryQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Brd {
  id          String   @id @default(cuid())
  projectId   String   @unique
  // Konten BRD disimpan sebagai JSON fleksibel: { overview, goals, features, techRequirements, ... }
  content     Json
  version     Int      @default(1)
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RoadmapPhase {
  id        String  @id @default(cuid())
  projectId String
  order     Int
  title     String
  description String?
  layer     String  // DATABASE | BACKEND | FRONTEND | INTEGRATION

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features  RoadmapFeature[]

  @@index([projectId])
}

model RoadmapFeature {
  id          String  @id @default(cuid())
  phaseId     String
  title       String
  description String?

  phase        RoadmapPhase         @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  dependencies RoadmapDependency[]  @relation("FeatureDepsFrom")
  dependedOnBy RoadmapDependency[]  @relation("FeatureDepsTo")
  tasks        Task[]

  @@index([phaseId])
}

model RoadmapDependency {
  id           String @id @default(cuid())
  featureId    String
  dependsOnId  String

  feature   RoadmapFeature @relation("FeatureDepsFrom", fields: [featureId], references: [id], onDelete: Cascade)
  dependsOn RoadmapFeature @relation("FeatureDepsTo", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@index([featureId])
  @@index([dependsOnId])
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  featureId   String?
  title       String
  description String?
  layer       String   // DATABASE | BACKEND | FRONTEND | INTEGRATION
  status      String   @default("TODO") // TODO | IN_PROGRESS | REVIEW | DONE | BLOCKED
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  order       Int      @default(0)
  // aiContext: { files_to_create: string[], files_to_modify: string[], forbidden: string[] }
  aiContext     Json     @default("{}")
  acceptanceCriteria Json @default("[]")
  blockedReason String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feature      RoadmapFeature?  @relation(fields: [featureId], references: [id], onDelete: SetNull)
  dependsOn    TaskDependency[] @relation("TaskDepsFrom")
  dependencies TaskDependency[] @relation("TaskDepsTo")

  @@index([projectId])
  @@index([featureId])
  @@index([status])
}

model TaskDependency {
  id          String @id @default(cuid())
  taskId      String
  dependsOnId String

  task      Task @relation("TaskDepsFrom", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDepsTo", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([dependsOnId])
}

// ============================================================
// Agent (CLI) — PAT & session
// ============================================================

model AgentToken {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  name        String
  tokenHash   String   @unique // sha256(token)
  lastUsedAt  DateTime?
  isRevoked   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions AgentSession[]

  @@index([userId])
  @@index([projectId])
}

model AgentSession {
  id        String   @id @default(cuid())
  tokenId   String
  taskId    String?
  startedAt DateTime @default(now())
  endedAt   DateTime?

  token AgentToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
}

model Checkpoint {
  id        String   @id @default(cuid())
  projectId String
  type      String   // LAYER_TRANSITION | BRD_APPROVAL | ROADMAP_APPROVAL | APPS_READY_FOR_USE
  layer     String?
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  message   String?
  metadata  Json     @default("{}")
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}
